\set QUIET ON
\pset null '[NULL]'
\x auto
\set HISTFILE ~/.psql_history- :DBNAME
\set VERBOSITY verbose
\setenv EDITOR 'nvim'
\set QUIET OFF
-- BEGIN入力漏れ防止
-- \set AUTOCOMMIT off
-- \echo AUTOCOMMIT :AUTOCOMMIT

-- PROMPT1：psqlが新しいコマンドを受け付ける際に発行される通常のプロンプト
-- PROMPT2：コマンドがセミコロンで終わっていない、または、引用符が閉じていないなど、コマンドの入力中にさらなる入力が期待される際に発行されるプロンプト
-- PROMPT3：SQLのCOPY FROM STDINコマンドを実行中で、端末上で行の値の入力が必要な際に発行されるプロンプト
-- 予約語: https://www.postgresql.jp/docs/13/app-psql.html#APP-PSQL-PROMPTING
/* color
31 for red
32 for green
33 for yellow
34 for blue
35 for magenta
36 for cyan
37 for white
*/

-- 案件固有の環境判定はここに書かない。
--
-- このリポジトリは public。DB名・DBユーザー名・prod判定に使うポート番号は
-- 案件codeや顧客略号そのものなので、~/.config/psql/psqlrc.local へ置く。
-- 雛形は psqlrc.local.example（dotfilesLink.sh が無い端末へコピーする）。
--
-- psqlrc.local の責務は次の2つだけ。
--   1. is_prod_local / is_stg_local を上書きする（\gset で真偽値を入れる）
--   2. 案件固有のバナーを出す
\set is_prod_local false
\set is_stg_local false

-- psqlrc.local を任意読み込みする。
-- psql の \i は cwd 基準で解決し ~ も展開しないため、シェル置換で絶対パスへ直す。
-- 無い端末では /dev/null を読み、何も起きない（エラーも出ない）。
\set LOCALRC `f="$HOME/.config/psql/psqlrc.local"; test -f "$f" && echo "$f" || echo /dev/null`
\i :LOCALRC

-- 汎用の命名規約による判定と、psqlrc.local の判定の論理和をとる。
--
-- :'var'::boolean と引用付きで埋めるのは、\gset が入れる値が SQL の真偽値リテラルでは
-- なく表示形の t / f になるため。素の :var だと 'f' が列名と解釈され
-- `column "f" does not exist` で落ちる。引用してキャストすれば t/f と true/false の
-- どちらでも通る。
-- COALESCE で包むのは、psqlrc.local の判定が NULL を返したときに
-- \if が不正値で落ちて PROMPT1 の色分けごと失われるのを防ぐため。
SELECT COALESCE(current_database() ~ '.*_prod' OR :'is_prod_local'::boolean, false) AS is_prod
\gset
SELECT COALESCE(current_database() ~ '.*_(stg|stga|stgb|dev)' OR :'is_stg_local'::boolean, false) AS is_stg
\gset

\if :is_prod
	-- \set PROMPT1 '%[%033[1;31m%]DANGER_PROD_ENV %n@%/%R%#%[%033[1;33m%]%x %[%033[1;31m%]'
	\set PROMPT1 '%[%033[1;31m%]DANGER_PROD_ENV %> %n@%/%R%#%[%033[1;33m%]%x %[%033[1;31m%]'
\elif :is_stg
	\set PROMPT1 '%[%033[1;33m%]WARNING_STG_ENV %n@%/%R%#%[%033[1;31m%]%x %[%033[1;33m%]'
\else
	-- do nothing
	\set PROMPT1 '%[%033[1;37m%]%n@%/%R%#%[%033[1;31m%]%x %[%033[1;37m%]'
\endif
