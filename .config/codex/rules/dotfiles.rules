# GitとGitHubで日常的に使う操作をsandbox外で自動許可する。
# `gh api` はmethod次第で書き込めるため、包括的に許可しない。
prefix_rule(
    pattern = ["git", "commit"],
    decision = "allow",
    justification = "ユーザーがGit commitの常時実行を承認している",
    match = [
        "git commit -m subject",
        "git commit --amend --no-edit",
    ],
    not_match = [
        "git add .",
        "git push origin main",
        "git -C /tmp/example commit -m subject",
    ],
)

prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
    justification = "ユーザーがGitのstaging操作を常時承認している",
    match = [
        "git add path/to/file",
        "git add -A",
    ],
    not_match = [
        "git commit -m subject",
        "git -C /tmp/example add path/to/file",
    ],
)

prefix_rule(
    pattern = ["git", "diff"],
    decision = "allow",
    justification = "Git差分の参照のみを行う",
    match = [
        "git diff",
        "git diff --cached --stat",
    ],
    not_match = [
        "git apply patch.diff",
        "git -C /tmp/example diff",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", "view"],
    decision = "allow",
    justification = "PRの参照のみを行う",
    match = [
        "gh pr view 123",
        "gh pr view 123 --json title,url",
    ],
    not_match = [
        "gh pr review 123 --approve",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", "diff"],
    decision = "allow",
    justification = "PR diffの参照のみを行う",
    match = [
        "gh pr diff 123",
        "gh pr diff 123 --color always",
    ],
    not_match = [
        "gh pr checkout 123",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", "review"],
    decision = "allow",
    justification = "PRにreviewを投稿する",
    match = [
        "gh pr review 123 --approve",
        "gh pr review 123 --comment --body looks-good",
    ],
    not_match = [
        "gh pr merge 123",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", "checkout"],
    decision = "allow",
    justification = "PR branchをlocal worktreeにcheckoutする",
    match = [
        "gh pr checkout 123",
        "gh pr checkout 123 --detach",
    ],
    not_match = [
        "gh pr merge 123",
    ],
)
