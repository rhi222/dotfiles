.config/nvim/pack
.config/nvim/.netrwhist
plans/
docs/superpowers/
# superpowers subagent-driven-development のスクラッチ（ledger・brief・レビュー用diff）
.superpowers/
.serena/
.config/codex/config.toml
.config/AutoHotkey/ahk-snippets/passwords/*
!.config/AutoHotkey/ahk-snippets/passwords/.gitkeep
!.config/AutoHotkey/ahk-snippets/passwords/README.md
.config/tmux/plugins/
.config/yazi/plugins/
.config/git/config-local
.config/git/config-work
.config/fish/my/conf.d/99-local.fish

# External skills (npx skill add)
.claude/skills/
# Sensitive data
#
# このリポジトリは public。社内固有情報を含むものはここで追跡から外す。
# 運用の全体像は AGENTS.md の「社内固有情報を入れない運用」を参照。
.config/claude/skills/cross-repo-investigate/repos.yml
.config/claude/skills/esa-weekly-report/esa-weekly-report-posts.json

# 社内システム名を検知して発動するスキル。description の発動キーワードが
# 社内システム名そのものなので、汎用化すると機能しなくなる。
#
# 末尾に / を付けない。private bundle（scripts/private-bundle.sh）へ集約すると
# ここは symlink になり、ディレクトリ限定パターンでは ignore から外れるため。
.config/claude/skills/cross-repo-auto-discover

# skill-creator が skill の隣に作る作業ディレクトリ（テスト実行の中間生成物）。
# dotfilesLink.sh もリンク対象から除外している。
.config/claude/skills/*-workspace/

# nvim のローカル設定（社内ホスト名など）。雛形は local_config.lua.example
.config/nvim/lua/my/local_config.lua

# 社内固有値の集約先。実体は ~/.claude/local-context.md（リポジトリ外）だが、
# .config/claude/ 配下に置いてしまった場合の保険として ignore しておく。
.config/claude/local-context.md

# 社内システム向けのJSスニペット。ファイル名にシステム名が入るため、
# ファイル単位で書くとこの .gitignore 自体が漏洩源になる。ディレクトリごと外す。
# 末尾に / を付けない理由は cross-repo-auto-discover と同じ（symlink になるため）。
.config/AutoHotkey/ahk-snippets/js
# 上のスニペットを登録するローカル定義。text-snippet.ahk が任意 include する
.config/AutoHotkey/scripts/snippets-local.ahk

# vendored な外部 skill に upstream の git メタデータを持ち込まない
# （skill-vendor.sh は tar --exclude=.git で除いているが、手作業の取り違え対策）
.config/claude/skills-vendor/**/.git
.config/claude/skills-vendor/**/.gitmodules
.config/claude/skills-vendor/**/node_modules
